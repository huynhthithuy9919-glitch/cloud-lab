{
  "name": "@adviser/cement",
  "version": "0.5.36",
  "license": "AFL-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./web-env": "./src/web-env/index.ts",
    "./cf-env": "./src/cf-env/index.ts",
    "./node-env": "./src/node-env/index.ts",
    "./deno-env": "./src/deno-env/index.ts",
    "./cli": "./src/cli/index.ts",
    "./import-meta-env": "./src/import-meta-env.module.ts"
  },
  "unstable": [
    "sloppy-imports"
  ],
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-sloppy-imports"
      ]
    },
    "exclude": [
      "cjs/",
      "esm/**/*",
      "node_modules/"
    ]
  },
  "imports": {
    "ts-essentials": "npm:ts-essentials@^10.2.0",
    "yaml": "npm:yaml@^2.8.4",
    "@adviser/cement": "./src/index.ts",
    "@adviser/cement/web-env": "./src/web-env/index.ts",
    "@adviser/cement/cf-env": "./src/cf-env/index.ts",
    "@adviser/cement/node-env": "./src/node-env/index.ts",
    "@adviser/cement/deno-env": "./src/deno-env/index.ts",
    "@adviser/cement/cli": "./src/cli/index.ts",
    "@adviser/cement/import-meta-env": "./src/import-meta-env.module.ts"
  },
  "exclude": [
    "cjs/",
    "esm/**/*",
    "node_modules/"
  ],
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ]
  }
}
